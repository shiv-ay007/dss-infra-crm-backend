<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>DSS Infra CRM | Server Status</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Inter, Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background:
        radial-gradient(circle at top left, #243b7a 0%, transparent 35%),
        radial-gradient(circle at bottom right, #0b765e 0%, transparent 35%),
        #080d19;
      color: white;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 850px;
    }

    .card {
      position: relative;
      overflow: hidden;
      padding: 55px 45px;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 28px;
      background: rgba(15, 23, 42, 0.82);
      backdrop-filter: blur(20px);
      box-shadow: 0 30px 80px rgba(0,0,0,0.4);
      text-align: center;
    }

    .logo {
      width: 78px;
      height: 78px;
      margin: 0 auto 25px;
      border-radius: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2563eb, #14b8a6);
      font-size: 30px;
      font-weight: 800;
      box-shadow: 0 12px 35px rgba(37,99,235,0.35);
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 9px 18px;
      border-radius: 50px;
      background: rgba(34,197,94,0.12);
      border: 1px solid rgba(34,197,94,0.25);
      color: #4ade80;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 22px;
    }

    .dot {
      width: 9px;
      height: 9px;
      background: #22c55e;
      border-radius: 50%;
      box-shadow: 0 0 12px #22c55e;
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(1.4);
        opacity: 0.5;
      }

      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    h1 {
      font-size: clamp(32px, 5vw, 52px);
      line-height: 1.1;
      margin-bottom: 15px;
      background: linear-gradient(90deg, #ffffff, #94a3b8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .description {
      color: #94a3b8;
      font-size: 17px;
      line-height: 1.6;
      margin-bottom: 40px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
      margin-bottom: 30px;
    }

    .info-box {
      padding: 20px 15px;
      border-radius: 18px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .label {
      color: #64748b;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .value {
      color: #e2e8f0;
      font-size: 15px;
      font-weight: 600;
      word-break: break-word;
    }

    .footer {
      padding-top: 25px;
      border-top: 1px solid rgba(255,255,255,0.08);
      color: #64748b;
      font-size: 13px;
    }

    .footer span {
      color: #94a3b8;
    }

    @media (max-width: 650px) {
      .card {
        padding: 40px 22px;
      }

      .info-grid {
        grid-template-columns: 1fr;
      }

      h1 {
        font-size: 34px;
      }
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="card">

      <div class="logo">
        DI
      </div>

      <div class="status">
        <span class="dot"></span>
        SERVER <%= status %>
      </div>

      <h1>
        DSS Infra CRM API
      </h1>

      <p class="description">
        <%= message %>
      </p>

      <div class="info-grid">

        <div class="info-box">
          <div class="label">System Status</div>
          <div class="value">✓ Operational</div>
        </div>

        <div class="info-box">
          <div class="label">API Version</div>
          <div class="value"><%= version %></div>
        </div>

        <div class="info-box">
          <div class="label">Environment</div>
          <div class="value"><%= environment %></div>
        </div>

      </div>

      <div class="footer">
        Last checked:
        <span><%= time %></span>
        <br /><br />
        © <%= new Date().getFullYear() %> DSS Infra CRM. All rights reserved.
      </div>

    </div>

  </div>

</body>
</html>